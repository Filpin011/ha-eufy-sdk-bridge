{
  "name": "ha-eufy-sdk-bridge",
  "version": "0.1.60",
  "private": true,
  "type": "module",
  "description": "WebSocket + HTTP bridge exposing the eufy-sdk SDK to a frontend (Home Assistant, a web UI, anything), with go2rtc for live video.",
  "main": "server.mjs",
  "bin": {
    "eufy-sdk-bridge": "bin/start.sh"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "use:sdk-beta": "npm install --no-save @mega-yfue/eufy-sdk@beta"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@mega-yfue/eufy-sdk": "0.1.0",
    "eufy-security-client": "^3.8.0",
    "ws": "^8.18.0"
  }
}
